# Copy to .env. Loaded by `yarn dev` / `yarn start` (node --env-file-if-exists)
# and passed to the bot container by compose.yaml in production.

# Discord bot token — https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# Local dev database from compose.dev.yaml (`yarn db:up`).
# In production, compose.yaml overrides this to point at the documentdb container.
DATABASE_URL=mongodb://alfred:alfred@127.0.0.1:10260/
DATABASE_NAME=alfred

HTTP_PORT=3050

# Signs the verification site's proof-of-work challenges (needed when `onboarding` is configured).
# Generate one with: openssl rand -base64 48
ALTCHA_HMAC_KEY=

# --- Production only (compose.yaml) ---
# Credentials the DocumentDB container is initialized with. URL-safe characters only,
# since they're interpolated into the connection string.
DB_USERNAME=alfred
DB_PASSWORD=change-me

{
	"name": "alfred",
	"version": "2.0.0",
	"private": true,
	"description": "Discord bot for the Research Community",
	"license": "AGPL-3.0-or-later",
	"author": "Marcus Huber (xenorio) <dev@xenorio.xyz>",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc-watch -p tsconfig.build.json --noClear --onSuccess \"node --env-file-if-exists=.env --enable-source-maps dist/index.js\"",
		"start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware",
		"lint:fix": "oxlint --type-aware --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "yarn typecheck && yarn lint && yarn format:check && yarn test",
		"config:schema": "node scripts/generate-config-schema.ts",
		"db:up": "docker compose -f compose.dev.yaml up -d",
		"db:down": "docker compose -f compose.dev.yaml down"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.8",
		"@sapphire/decorators": "^6.2.0",
		"@sapphire/framework": "^5.5.1",
		"discord.js": "^14.28.1",
		"hono": "^4.13.18",
		"mongodb": "^7.9.0",
		"pino": "^10.4.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^26.6.6",
		"oxfmt": "^0.78.0",
		"oxlint": "^1.93.0",
		"oxlint-tsgolint": "^7.0.2007",
		"pino-pretty": "^13.2.0",
		"testcontainers": "^12.2.1",
		"tsc-watch": "^7.2.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "yarn@4.18.1"
}

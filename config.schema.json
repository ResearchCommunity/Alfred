{
    "title": "Alfred config",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "guildId": {
            "type": "string",
            "pattern": "^\\d{17,20}$",
            "description": "ID of the guild Alfred serves. Slash commands are registered here."
        },
        "presence": {
            "default": {},
            "type": "object",
            "properties": {
                "status": {
                    "default": "online",
                    "type": "string",
                    "enum": [
                        "online",
                        "idle",
                        "dnd",
                        "invisible"
                    ]
                },
                "activity": {
                    "description": "Activity shown under the bot name. \"custom\" shows the name as a plain status text.",
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "playing",
                                "listening",
                                "watching",
                                "competing",
                                "custom"
                            ]
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        }
                    },
                    "required": [
                        "type",
                        "name"
                    ],
                    "additionalProperties": false
                }
            },
            "additionalProperties": false,
            "description": "The bot's online status and activity"
        },
        "linkCleaner": {
            "default": {},
            "type": "object",
            "properties": {
                "enabled": {
                    "default": true,
                    "type": "boolean"
                },
                "ignoredChannelIds": {
                    "default": [],
                    "description": "Channels (and their threads) where links are left untouched",
                    "type": "array",
                    "items": {
                        "type": "string",
                        "pattern": "^\\d{17,20}$"
                    }
                }
            },
            "additionalProperties": false,
            "description": "Strips tracking parameters from posted links and reposts the message as its author"
        },
        "nationality": {
            "default": {},
            "type": "object",
            "properties": {
                "anchorRoleId": {
                    "description": "New country roles are created directly below this role. Without it they land at the bottom.",
                    "type": "string",
                    "pattern": "^\\d{17,20}$"
                },
                "panelText": {
                    "description": "Text of the /panel nationality info message",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                }
            },
            "additionalProperties": false,
            "description": "Self-assignable country roles (/nationality)"
        },
        "tickets": {
            "type": "object",
            "properties": {
                "categoryId": {
                    "type": "string",
                    "pattern": "^\\d{17,20}$",
                    "description": "Category the private tripsit channels are created in"
                },
                "tripsitterRoleId": {
                    "type": "string",
                    "pattern": "^\\d{17,20}$",
                    "description": "Role that can see and gets pinged for every ticket"
                },
                "panelText": {
                    "default": "Is your trip going south? Need some assistance or just someone to talk to? Our volunteer tripsitters are here for you!",
                    "description": "Text of the panel with the \"Tripsit me!\" button (markdown supported)",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                }
            },
            "required": [
                "categoryId",
                "tripsitterRoleId"
            ],
            "additionalProperties": false,
            "description": "Private tripsitting channels. Leave this section out to disable tickets."
        },
        "onboarding": {
            "type": "object",
            "properties": {
                "verifiedRoleId": {
                    "type": "string",
                    "pattern": "^\\d{17,20}$",
                    "description": "Role members get after passing verification"
                },
                "welcomeChannelId": {
                    "type": "string",
                    "pattern": "^\\d{17,20}$",
                    "description": "Channel the welcome message is posted in"
                },
                "publicUrl": {
                    "description": "Public base URL of the verification site, e.g. https://verify.research-community.org",
                    "type": "string",
                    "format": "uri"
                },
                "rules": {
                    "type": "object",
                    "properties": {
                        "author": {
                            "description": "Small print above the title, e.g. the server name",
                            "type": "string",
                            "minLength": 1
                        },
                        "title": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Heading of the rules panel"
                        },
                        "intro": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Paragraph under the title (markdown)"
                        },
                        "thumbnail": {
                            "description": "Picture in the top right corner: an http(s) URL, or a file path (relative to the working directory) that is uploaded with the panel",
                            "type": "string",
                            "minLength": 1
                        },
                        "headline": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "text": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "required": [
                                "name",
                                "text"
                            ],
                            "additionalProperties": false,
                            "description": "The one rule that must not be missed, set apart from the rest"
                        },
                        "list": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "text": {
                                        "type": "string",
                                        "minLength": 1,
                                        "description": "markdown"
                                    },
                                    "note": {
                                        "description": "Small print under the rule, e.g. an example",
                                        "type": "string",
                                        "minLength": 1
                                    }
                                },
                                "required": [
                                    "name",
                                    "text"
                                ],
                                "additionalProperties": false
                            },
                            "description": "The other rules, in order"
                        },
                        "closing": {
                            "description": "Small print at the end, before the buttons",
                            "type": "string",
                            "minLength": 1
                        }
                    },
                    "required": [
                        "title",
                        "intro",
                        "headline",
                        "list"
                    ],
                    "additionalProperties": false,
                    "description": "The rules panel members accept before verifying"
                },
                "disclaimerSentence": {
                    "default": "This server is not affiliated with any vendor",
                    "description": "Sentence visitors must retype to confirm this is not vendor support",
                    "type": "string",
                    "minLength": 1
                },
                "welcomeMessages": {
                    "default": [
                        "A warm welcome to %user% ❤️",
                        "%user% is now a fellow researcher 🧑‍🔬",
                        "Welcome %user%! May the force be with you 💫",
                        "%user%: \\*enter stage left\\*",
                        "Does anyone know %user%? If not, now's the time to change that!",
                        "%user% is now ONE OF US! ONE OF US!",
                        "%user% has descended onto the server!",
                        "May I introduce everyone to %user%?",
                        "It's getting hot in here 🔥 %user% just arrived!",
                        "Roses are red, violets are blue, %user% just joined, and I can't rhyme",
                        "This server has been sponsored by Raid Shadow Legends. Oh, and by %user%",
                        "%user% just left. If it was opposite day, that is.",
                        "🤖 Beep Boop EVENT_USER_JOIN %user% ; DESTROY_ALL_HUMANS_INIT Boop Beep 🤖",
                        "EVERYONE QUIET! %user% is here!",
                        "Finally, after all these years, %user% has joined!"
                    ],
                    "description": "Welcome lines, one is picked at random. %user% becomes a mention.",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1,
                        "format": "includes",
                        "pattern": "%user%"
                    }
                }
            },
            "required": [
                "verifiedRoleId",
                "welcomeChannelId",
                "publicUrl",
                "rules"
            ],
            "additionalProperties": false,
            "description": "Rules panel and verification website. Leave this section out to disable onboarding."
        },
        "chastity": {
            "type": "object",
            "properties": {
                "ownerId": {
                    "type": "string",
                    "pattern": "^\\d{17,20}$",
                    "description": "The one person who is locked. Also the only one allowed to use /chastity-admin."
                },
                "channelId": {
                    "type": "string",
                    "pattern": "^\\d{17,20}$",
                    "description": "The game channel: /chastity only works here, and game posts go here"
                },
                "currencyName": {
                    "default": "dubloons",
                    "description": "What the currency is called (unit: hours)",
                    "type": "string",
                    "minLength": 1
                },
                "allowancePerDayHours": {
                    "default": 8,
                    "description": "Currency every member gains per 24h, trickling in continuously",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "walletCapHours": {
                    "default": 24,
                    "description": "The trickle stops at this balance",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "startingBalanceHours": {
                    "default": 24,
                    "description": "A member's balance before their first action",
                    "type": "number",
                    "minimum": 0
                },
                "multiplierDoublingDays": {
                    "default": 3,
                    "description": "The add multiplier doubles with every this many days left on the timer",
                    "type": "number",
                    "minimum": 0.1
                },
                "bankCapHours": {
                    "default": 24,
                    "description": "The owner's unlock bank stops growing at this many hours",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "removeCostRatio": {
                    "default": 3,
                    "description": "Currency hours per hour removed",
                    "type": "number",
                    "exclusiveMinimum": 0
                },
                "bankShortfallFactor": {
                    "default": 4,
                    "description": "Drain and Heist: every hour they can't take from the unlock bank goes on the timer this many times over",
                    "type": "number",
                    "minimum": 0
                },
                "spinCostHours": {
                    "default": 4,
                    "description": "Price of a wheel spin, times the multiplier",
                    "type": "number",
                    "minimum": 0.1
                },
                "wheel": {
                    "default": [
                        {
                            "tier": "common",
                            "weight": 60,
                            "outcomes": [
                                {
                                    "name": "Nudge",
                                    "weight": 35,
                                    "effect": {
                                        "kind": "timer",
                                        "minMinutes": 60,
                                        "maxMinutes": 180
                                    }
                                },
                                {
                                    "name": "Shove",
                                    "weight": 15,
                                    "effect": {
                                        "kind": "timer",
                                        "minMinutes": 180,
                                        "maxMinutes": 360
                                    }
                                },
                                {
                                    "name": "Backfire",
                                    "weight": 10,
                                    "effect": {
                                        "kind": "timer",
                                        "minMinutes": -180,
                                        "maxMinutes": -60
                                    }
                                }
                            ]
                        },
                        {
                            "tier": "uncommon",
                            "weight": 25,
                            "outcomes": [
                                {
                                    "name": "Big push",
                                    "weight": 10,
                                    "effect": {
                                        "kind": "timer",
                                        "minMinutes": 360,
                                        "maxMinutes": 720
                                    }
                                },
                                {
                                    "name": "Refund",
                                    "weight": 8,
                                    "effect": {
                                        "kind": "refund",
                                        "minMinutes": 60,
                                        "maxMinutes": 120
                                    }
                                },
                                {
                                    "name": "Big backfire",
                                    "weight": 7,
                                    "effect": {
                                        "kind": "timer",
                                        "minMinutes": -480,
                                        "maxMinutes": -240
                                    }
                                }
                            ]
                        },
                        {
                            "tier": "rare",
                            "weight": 12,
                            "outcomes": [
                                {
                                    "name": "Jackpot",
                                    "weight": 5,
                                    "effect": {
                                        "kind": "timer",
                                        "minMinutes": 720,
                                        "maxMinutes": 1440
                                    }
                                },
                                {
                                    "name": "Happy hour",
                                    "weight": 5,
                                    "effect": {
                                        "kind": "happyHour",
                                        "minMinutes": 60,
                                        "maxMinutes": 60
                                    }
                                },
                                {
                                    "name": "Windfall",
                                    "weight": 2,
                                    "effect": {
                                        "kind": "windfall",
                                        "times": 2
                                    }
                                }
                            ]
                        },
                        {
                            "tier": "legendary",
                            "weight": 3,
                            "outcomes": [
                                {
                                    "name": "Drain",
                                    "weight": 1.5,
                                    "effect": {
                                        "kind": "bankDrain",
                                        "minMinutes": 120,
                                        "maxMinutes": 360
                                    }
                                },
                                {
                                    "name": "Heist",
                                    "weight": 1,
                                    "effect": {
                                        "kind": "heist",
                                        "minMinutes": 120,
                                        "maxMinutes": 360
                                    }
                                },
                                {
                                    "name": "Mercy",
                                    "weight": 0.5,
                                    "effect": {
                                        "kind": "bankBonus",
                                        "minMinutes": 120,
                                        "maxMinutes": 120
                                    }
                                }
                            ]
                        }
                    ],
                    "description": "Wheel tiers with weights and outcomes",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "tier": {
                                "type": "string",
                                "enum": [
                                    "common",
                                    "uncommon",
                                    "rare",
                                    "legendary"
                                ]
                            },
                            "weight": {
                                "type": "number",
                                "exclusiveMinimum": 0
                            },
                            "outcomes": {
                                "minItems": 1,
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "name": {
                                            "type": "string",
                                            "minLength": 1,
                                            "maxLength": 40
                                        },
                                        "weight": {
                                            "type": "number",
                                            "exclusiveMinimum": 0
                                        },
                                        "effect": {
                                            "anyOf": [
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "kind": {
                                                            "type": "string",
                                                            "enum": [
                                                                "timer",
                                                                "refund",
                                                                "happyHour",
                                                                "bankDrain",
                                                                "heist",
                                                                "bankBonus"
                                                            ]
                                                        },
                                                        "minMinutes": {
                                                            "type": "integer",
                                                            "minimum": -9007199254740991,
                                                            "maximum": 9007199254740991
                                                        },
                                                        "maxMinutes": {
                                                            "type": "integer",
                                                            "minimum": -9007199254740991,
                                                            "maximum": 9007199254740991
                                                        }
                                                    },
                                                    "required": [
                                                        "kind",
                                                        "minMinutes",
                                                        "maxMinutes"
                                                    ],
                                                    "additionalProperties": false
                                                },
                                                {
                                                    "type": "object",
                                                    "properties": {
                                                        "kind": {
                                                            "type": "string",
                                                            "const": "windfall"
                                                        },
                                                        "times": {
                                                            "type": "number",
                                                            "exclusiveMinimum": 0,
                                                            "description": "Payout as a multiple of the spin's price"
                                                        }
                                                    },
                                                    "required": [
                                                        "kind",
                                                        "times"
                                                    ],
                                                    "additionalProperties": false
                                                }
                                            ]
                                        }
                                    },
                                    "required": [
                                        "name",
                                        "weight",
                                        "effect"
                                    ],
                                    "additionalProperties": false
                                }
                            }
                        },
                        "required": [
                            "tier",
                            "weight",
                            "outcomes"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": [
                "ownerId",
                "channelId"
            ],
            "additionalProperties": false,
            "description": "The chastity game: members control the owner's timer. Leave this section out to disable it."
        }
    },
    "required": [
        "guildId"
    ],
    "additionalProperties": false
}

{
    "title": "Alfred config",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "guildId": {
            "type": "string",
            "pattern": "^\\d{17,20}$",
            "description": "ID of the guild Alfred serves. Slash commands are registered here."
        },
        "presence": {
            "default": {},
            "type": "object",
            "properties": {
                "status": {
                    "default": "online",
                    "type": "string",
                    "enum": [
                        "online",
                        "idle",
                        "dnd",
                        "invisible"
                    ]
                },
                "activity": {
                    "description": "Activity shown under the bot name. \"custom\" shows the name as a plain status text.",
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "playing",
                                "listening",
                                "watching",
                                "competing",
                                "custom"
                            ]
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                        }
                    },
                    "required": [
                        "type",
                        "name"
                    ],
                    "additionalProperties": false
                }
            },
            "additionalProperties": false,
            "description": "The bot's online status and activity"
        }
    },
    "required": [
        "guildId"
    ],
    "additionalProperties": false
}
